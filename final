<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Pookie Store · Álbumes K-pop</title>
<meta name="description" content="Pookie Store: tienda de álbumes K-pop, photocards y más. Busca tu grupo favorito y compra fácil.">
<meta name="theme-color" content="#ffc4dc">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%92%BF%3C/text%3E%3C/svg%3E">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&family=Nunito:wght@500;700&display=swap">
<style>
:root{--pink:#ffc4dc;--pink2:#ff8fbd;--blue:#b5e6f2;--blue2:#7fcfe6;--lav:#d4c8ff;--plum:#5b2147;--bg:#fff7fb;--card:#fff;--ink:#4a2040;--soft:#fdeaf3;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#2a1630;--card:#3b2145;--ink:#ffe9f4;--soft:#472a54}}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}
body{margin:0;font-family:Nunito,system-ui,sans-serif;background:var(--bg);color:var(--ink);overflow-x:hidden;
background-image:radial-gradient(var(--blue) 2px,transparent 2px),radial-gradient(var(--pink) 2px,transparent 2px);background-size:46px 46px;background-position:0 0,23px 23px}
h1,h2,h3,.fun{font-family:'Baloo 2',cursive;margin:0}
button{font:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--plum);outline-offset:2px}
nav{position:sticky;top:0;z-index:20;display:flex;align-items:center;flex-wrap:wrap;gap:8px;padding:8px 18px;background:linear-gradient(90deg,var(--pink),var(--blue));border-bottom:4px solid var(--plum)}
nav img{height:46px;cursor:pointer}nav .sp{flex:1}
.pill{border:3px solid var(--plum);background:#fff;color:var(--plum);border-radius:99px;padding:7px 14px;font-weight:700;box-shadow:0 4px 0 var(--plum);transition:transform .1s,box-shadow .1s;text-decoration:none;display:inline-block;font-size:.95rem}
.pill:hover{transform:translateY(2px);box-shadow:0 2px 0 var(--plum)}
.pill.hot{background:var(--pink2);color:#fff}.pill.blue{background:var(--blue2);color:#fff}.pill.lav{background:var(--lav);color:var(--plum)}
.hero{text-align:center;padding:36px 16px 20px;position:relative}
.hero img{width:min(560px,90%);animation:bob 3.2s ease-in-out infinite;filter:drop-shadow(0 10px 0 rgba(91,33,71,.12))}
@keyframes bob{50%{transform:translateY(-10px) rotate(-1.5deg)}}
.hero p{font-size:1.2rem;font-weight:700;max-width:560px;margin:10px auto 18px}
.marquee{background:var(--plum);color:#fff;overflow:hidden;white-space:nowrap;padding:8px 0;font-family:'Baloo 2';font-size:1.1rem;transform:rotate(-1deg);margin:14px -10px}
.marquee span{display:inline-block;animation:slide 26s linear infinite}
@keyframes slide{to{transform:translateX(-50%)}}
section{max-width:1150px;margin:0 auto;padding:30px 16px}
.title{font-size:2.1rem;color:var(--plum);text-align:center;margin-bottom:16px}
@media (prefers-color-scheme:dark){.title{color:var(--pink)}}
.box{background:var(--card);border:4px solid var(--plum);border-radius:26px;box-shadow:8px 8px 0 var(--blue2);padding:24px}
.search{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;position:sticky;top:calc(68px + env(safe-area-inset-top,0px));z-index:15;padding:8px;background:var(--bg);border-radius:99px}
.search input{font:inherit;border:3px solid var(--plum);border-radius:99px;padding:10px 18px;background:var(--card);color:var(--ink);min-width:0;flex:1;max-width:520px}
.chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:14px 0}
.chip{border:3px solid var(--plum);background:var(--card);color:var(--ink);border-radius:99px;padding:4px 14px;font-weight:700}
.chip.on{background:var(--blue2);color:#fff}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:22px;margin-top:14px}
.card{background:var(--card);border:4px solid var(--plum);border-radius:24px;padding:12px;box-shadow:6px 6px 0 var(--pink2);position:relative;transition:transform .2s}
.card:hover{transform:translateY(-6px) rotate(-1deg)}
.cover{aspect-ratio:1;border-radius:16px;border:3px solid var(--plum);position:relative;overflow:hidden;display:grid;place-items:center;background:linear-gradient(135deg,var(--pink),var(--blue))}
.cover img{width:100%;height:100%;object-fit:cover}
.disc{position:absolute;width:70%;aspect-ratio:1;border-radius:50%;right:-30%;background:conic-gradient(#fff,var(--blue),var(--lav),#fff,var(--pink),#fff);border:3px solid var(--plum);transition:right .3s;z-index:0}
.card:hover .disc{right:-12%}
.cover .art{position:relative;z-index:1;font-family:'Baloo 2';font-weight:800;color:#fff;font-size:1.4rem;text-align:center;text-shadow:2px 2px 0 var(--plum);padding:8px;line-height:1.1}
.tag{position:absolute;top:-10px;left:-8px;background:var(--lav);color:var(--plum);border:3px solid var(--plum);border-radius:99px;padding:1px 10px;font-weight:800;font-size:.8rem;z-index:2;transform:rotate(-6deg)}
.card h3{font-size:1.15rem;margin-top:10px;line-height:1.1}.card small{opacity:.8;font-weight:700}
.row{display:flex;justify-content:space-between;align-items:center;margin-top:8px;gap:6px}
.price{font-family:'Baloo 2';font-size:1.3rem;color:var(--pink2);font-weight:800}
.page-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px}
.about-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;margin-top:20px}
.about-card{background:var(--soft);border:3px solid var(--plum);border-radius:20px;padding:18px}
.drawer{position:fixed;top:0;right:0;height:100%;width:min(400px,100%);background:var(--card);border-left:5px solid var(--plum);z-index:40;transform:translateX(105%);transition:transform .3s;display:flex;flex-direction:column;padding:16px}
.drawer.open{transform:none}
.items{flex:1;overflow:auto;display:grid;gap:10px;align-content:start}
.item{display:flex;gap:8px;align-items:center;background:var(--soft);border-radius:16px;padding:8px;font-weight:700}
.item span{flex:1}.item button{border:2px solid var(--plum);border-radius:8px;background:#fff;width:28px;height:28px;color:var(--plum)}
.toast{position:fixed;left:50%;bottom:20px;transform:translate(-50%,160px);background:var(--plum);color:#fff;padding:10px 20px;border-radius:99px;font-weight:700;z-index:60;transition:transform .3s;border:3px solid var(--pink)}
.toast.show{transform:translate(-50%,0)}
footer{text-align:center;padding:30px 10px 40px;font-weight:700}
[hidden]{display:none!important}
</style>
</head>
<body>

<!-- BARRA DE NAVEGACIÓN -->
<nav>
  <button class="pill" onclick="openPage('home')">🏠 Inicio</button>
  <!-- BOTÓN RENOMBRADO A "NOSOTROS" + GIRL GROUPS Y BOY GROUPS AL LADO -->
  <button class="pill lav" onclick="openPage('nosotros')">💖 Nosotros</button>
  <button class="pill hot" onclick="openPage('girls')">🎀 Girl Groups</button>
  <button class="pill blue" onclick="openPage('boys')">💙 Boy Groups</button>
  <div class="sp"></div>
  <button class="pill" id="cartBtn" onclick="toggleCart()">🛍️ Carrito (<span id="cartCount">0</span>)</button>
</nav>

<!-- ========================================================= -->
<!-- 1. PÁGINA DE INICIO (SIN LA SECCIÓN DE NOSOTROS)          -->
<!-- ========================================================= -->
<main id="page-home">
  <header class="hero">
    <h1 class="fun" style="font-size:clamp(2.4rem,6vw,4rem);color:var(--plum)">✨ Pookie Store ✨</h1>
    <p>Tu rincón de álbumes K-pop, photocards oficiales y mucho brillo pastel.</p>
    <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
      <button class="pill hot" onclick="openPage('girls')">Ver Girl Groups 🎀</button>
      <button class="pill blue" onclick="openPage('boys')">Ver Boy Groups 💙</button>
    </div>
  </header>

  <div class="marquee">
    <span>💿 ÁLBUMES SELLADOS · 🎀 PHOTOCARDS DE REGALO · ✨ ENVÍOS A TODO EL PAÍS · 💖 POOKIE STORE K-POP · 💿 ÁLBUMES SELLADOS · 🎀 PHOTOCARDS DE REGALO · ✨ ENVÍOS A TODO EL PAÍS · 💖 POOKIE STORE K-POP · </span>
  </div>

  <section id="tienda">
    <h2 class="title">💿 Catálogo Destacado</h2>
    <div class="search">
      <input type="search" id="searchInput" placeholder="Buscar grupo o álbum (ej. Stray Kids, NewJeans, TWICE...)" oninput="renderHomeProducts()">
    </div>
    <div class="grid" id="homeGrid"></div>
  </section>
</main>

<!-- ========================================================= -->
<!-- 2. PÁGINA INDEPENDIENTE: NOSOTROS                         -->
<!-- ========================================================= -->
<main id="page-nosotros" hidden>
  <section>
    <div class="page-header">
      <button class="pill" onclick="openPage('home')">← Volver al inicio</button>
      <span class="pill lav">Sobre Pookie Store</span>
    </div>

    <div class="box">
      <h2 class="title">💖 Nosotros</h2>
      <p style="font-size:1.1rem;line-height:1.6;text-align:center;max-width:750px;margin:0 auto">
        ¡Hola! Somos <strong>Pookie Store</strong>, una tienda nacida del amor por el K-pop, el coleccionismo y los detalles cute. 
        Nuestro objetivo es acercarte los álbumes originales de tus grupos favoritos con empaques seguros, llenos de cariño y freebies exclusivos en cada pedido.
      </p>

      <div class="about-grid">
        <div class="about-card">
          <h3>💿 100% Originales</h3>
          <p>Todos nuestros álbumes son importados directamente desde Corea del Sur, sellados y cuentan para los charts oficiales (Hanteo & Circle).</p>
        </div>
        <div class="about-card">
          <h3>🎀 Empaque Pookie</h3>
          <p>Protegemos cada esquina de tu álbum con burbujas, cartón reforzado y decoración pastel para que llegue impecable a tus manos.</p>
        </div>
        <div class="about-card">
          <h3>✨ Freebies en cada compra</h3>
          <p>Siempre incluimos photocards fanmade, stickers y dulces de regalo inspirados en tu bias o grupo favorito.</p>
        </div>
      </div>
    </div>
  </section>
</main>

<!-- ========================================================= -->
<!-- 3. PÁGINA INDEPENDIENTE: GIRL GROUPS                      -->
<!-- ========================================================= -->
<main id="page-girls" hidden>
  <section>
    <div class="page-header">
      <button class="pill" onclick="openPage('home')">← Volver al inicio</button>
      <span class="pill hot">🎀 Colección Girl Groups</span>
    </div>
    <h2 class="title">🎀 Álbumes Girl Groups</h2>
    <div class="grid" id="girlsGrid"></div>
  </section>
</main>

<!-- ========================================================= -->
<!-- 4. PÁGINA INDEPENDIENTE: BOY GROUPS                       -->
<!-- ========================================================= -->
<main id="page-boys" hidden>
  <section>
    <div class="page-header">
      <button class="pill" onclick="openPage('home')">← Volver al inicio</button>
      <span class="pill blue">💙 Colección Boy Groups</span>
    </div>
    <h2 class="title">💙 Álbumes Boy Groups</h2>
    <div class="grid" id="boysGrid"></div>
  </section>
</main>

<!-- CARRITO LATERAL -->
<aside class="drawer" id="cartDrawer">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
    <h2 class="fun">🛍️ Tu Carrito</h2>
    <button class="pill" onclick="toggleCart()">✕</button>
  </div>
  <div class="items" id="cartItems"></div>
  <div style="border-top:3px dashed var(--plum);padding-top:12px;margin-top:12px">
    <div style="display:flex;justify-content:space-between;font-weight:800;font-size:1.2rem;margin-bottom:10px">
      <span>Total:</span>
      <span id="cartTotal">$0</span>
    </div>
    <button class="pill hot" style="width:100%;text-align:center" onclick="checkout()">Finalizar Pedido ✨</button>
  </div>
</aside>

<div class="toast" id="toast"></div>

<footer>
  💖 Pookie Store · Todos los derechos reservados
</footer>

<script>
// BASE DE DATOS DE PRODUCTOS (Con categoría 'girl' o 'boy')
const PRODUCTS = [
  { id: 1, type: 'girl', group: 'NewJeans', title: 'Get Up (Bunny Beach Bag Ver.)', price: 28990, tag: 'Top Ventas' },
  { id: 2, type: 'girl', group: 'TWICE', title: 'With YOU-th (Digipack)', price: 19990, tag: 'Nuevo' },
  { id: 3, type: 'girl', group: 'aespa', title: 'Armageddon (Zine Ver.)', price: 24990, tag: 'Stock' },
  { id: 4, type: 'girl', group: 'LE SSERAFIM', title: 'EASY (Compact Ver.)', price: 18990, tag: 'Oferta' },
  { id: 5, type: 'boy', group: 'Stray Kids', title: 'ATE (Chk Chk / Boom Ver.)', price: 26990, tag: 'Top Ventas' },
  { id: 6, type: 'boy', group: 'TXT', title: 'minisode 3: TOMORROW', price: 25990, tag: 'Nuevo' },
  { id: 7, type: 'boy', group: 'ENHYPEN', title: 'ROMANCE : UNTOLD', price: 27990, tag: 'Stock' },
  { id: 8, type: 'boy', group: 'SEVENTEEN', title: '17 IS RIGHT HERE', price: 32990, tag: 'Deluxe' }
];

let cart = [];

// CAMBIAR ENTRE PÁGINAS (INICIO, NOSOTROS, GIRL GROUPS, BOY GROUPS)
function openPage(pageName) {
  const pages = ['home', 'nosotros', 'girls', 'boys'];
  pages.forEach(p => {
    document.getElementById('page-' + p).hidden = (p !== pageName);
  });

  if (pageName === 'girls') {
    renderGrid(PRODUCTS.filter(p => p.type === 'girl'), 'girlsGrid');
  } else if (pageName === 'boys') {
    renderGrid(PRODUCTS.filter(p => p.type === 'boy'), 'boysGrid');
  } else if (pageName === 'home') {
    renderHomeProducts();
  }

  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// RENDERIZAR TARJETAS DE PRODUCTOS
function renderGrid(list, containerId) {
  const container = document.getElementById(containerId);
  if (!list.length) {
    container.innerHTML = `<p style="grid-column:1/-1;text-align:center;font-weight:700">No se encontraron álbumes 💿</p>`;
    return;
  }
  container.innerHTML = list.map(p => `
    <article class="card">
      <span class="tag">${p.tag}</span>
      <div class="cover">
        <div class="disc"></div>
        <div class="art">${p.group}</div>
      </div>
      <small>${p.group} · ${p.type === 'girl' ? 'Girl Group' : 'Boy Group'}</small>
      <h3>${p.title}</h3>
      <div class="row">
        <span class="price">$${p.price.toLocaleString('es-CL')}</span>
        <button class="pill hot" onclick="addToCart(${p.id})">+ Agregar</button>
      </div>
    </article>
  `).join('');
}

function renderHomeProducts() {
  const q = document.getElementById('searchInput').value.toLowerCase().trim();
  const filtered = PRODUCTS.filter(p => 
    p.group.toLowerCase().includes(q) || p.title.toLowerCase().includes(q)
  );
  renderGrid(filtered, 'homeGrid');
}

// FUNCIONES DEL CARRITO
function addToCart(id) {
  const item = cart.find(i => i.id === id);
  if (item) {
    item.qty++;
  } else {
    const prod = PRODUCTS.find(p => p.id === id);
    cart.push({ ...prod, qty: 1 });
  }
  updateCartUI();
  showToast('💖 ¡Agregado a tu carrito!');
}

function changeQty(id, delta) {
  const idx = cart.findIndex(i => i.id === id);
  if (idx === -1) return;
  cart[idx].qty += delta;
  if (cart[idx].qty <= 0) cart.splice(idx, 1);
  updateCartUI();
}

function updateCartUI() {
  const count = cart.reduce((acc, i) => acc + i.qty, 0);
  const total = cart.reduce((acc, i) => acc + (i.price * i.qty), 0);
  document.getElementById('cartCount').textContent = count;
  document.getElementById('cartTotal').textContent = '$' + total.toLocaleString('es-CL');

  const box = document.getElementById('cartItems');
  if (!cart.length) {
    box.innerHTML = `<p style="text-align:center;opacity:.7">Tu carrito está vacío 🛍️</p>`;
    return;
  }
  box.innerHTML = cart.map(i => `
    <div class="item">
      <span>${i.group} - ${i.title}<br><small>$${(i.price * i.qty).toLocaleString('es-CL')}</small></span>
      <button onclick="changeQty(${i.id}, -1)">-</button>
      <b>${i.qty}</b>
      <button onclick="changeQty(${i.id}, 1)">+</button>
    </div>
  `).join('');
}

function toggleCart() {
  document.getElementById('cartDrawer').classList.toggle('open');
}

function checkout() {
  if (!cart.length) return showToast('Tu carrito está vacío 🛍️');
  showToast('✨ ¡Gracias por tu compra en Pookie Store!');
  cart = [];
  updateCartUI();
  toggleCart();
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2500);
}

// INICIALIZAR
renderHomeProducts();
updateCartUI();
</script>
</body>
</html>
