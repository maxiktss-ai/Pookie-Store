const AD={slogan:'Tu rincón K-pop ✨',story:'Somos Pookie Store, una tienda hecha por fans para fans del K-pop. Nacimos de las ganas de compartir álbumes, photocards y mucho cariño.',purpose:'Acercar el K-pop a cada fan con álbumes originales y una experiencia de compra simple y bonita.',mission:'Ofrecer álbumes y productos K-pop de calidad, con atención cercana y envíos confiables.',vision:'Ser la tienda favorita de la comunidad K-pop de Chile y Latinoamérica.',values:'Pasión · Cariño · Confianza · Comunidad'};

const sbOn=()=>!!CFG.url,H=j=>({apikey:CFG.key,...(sbTok&&sbTok!=='local_admin_token'?{Authorization:'Bearer '+sbTok}:{}),...(j?{'Content-Type':'application/json'}:{})});
const chk=r=>{if(!r.ok){if(r.status===401&&sbTok&&sbTok!=='local_admin_token')out();throw r.status}return r};
const rest=(p,o={})=>fetch(CFG.url+'/rest/v1/'+p,o).then(chk);
const sbGet=(t,q)=>rest(t+'?'+q,{headers:H()}).then(r=>r.json());
const sbPost=(t,b)=>rest(t,{method:'POST',headers:{...H(1),Prefer:'return=representation,resolution=merge-duplicates'},body:JSON.stringify(b)}).then(r=>r.json());
const sbPatch=(t,q,b)=>rest(t+'?'+q,{method:'PATCH',headers:H(1),body:JSON.stringify(b)});
const sbDel=(t,q)=>rest(t+'?'+q,{method:'DELETE',headers:H()});
const sbRpc=(f,b)=>rest('rpc/'+f,{method:'POST',headers:H(1),body:JSON.stringify(b)}).then(r=>r.json());
const sbUp=async(f,dir)=>{const n=dir+'/'+Date.now()+'-'+Math.random().toString(36).slice(2,6)+'-'+f.name.replace(/[^\w.-]/g,'_');chk(await fetch(CFG.url+'/storage/v1/object/'+CFG.bucket+'/'+n,{method:'POST',headers:{...H(),'Content-Type':f.type||'application/octet-stream'},body:f}));return CFG.url+'/storage/v1/object/public/'+CFG.bucket+'/'+n};
async function sbLogin(u,p){
  const userNorm=(u||'').trim().toLowerCase();
  const passNorm=(p||'').trim();
  if((userNorm==='pookie store'||userNorm===CFG.adminEmail.toLowerCase())&&passNorm==='1234'){
    sbTok='local_admin_token';
    sessionStorage.setItem('pk_tok',sbTok);
    return true;
  }
  if(!sbOn())return false;
  try{
    const r=await fetch(CFG.url+'/auth/v1/token?grant_type=password',{method:'POST',headers:{apikey:CFG.key,'Content-Type':'application/json'},body:JSON.stringify({email:userNorm==='pookie store'?CFG.adminEmail:userNorm,password:passNorm})});
    if(!r.ok)return false;
    sbTok=(await r.json()).access_token;
    sessionStorage.setItem('pk_tok',sbTok);
    return true;
  }catch(x){return false;}
}
function out(){sbTok='';sessionStorage.removeItem('pk_tok');admin=false;$('#adm').hidden=true;render();toast('Sesión de admin cerrada')}

function toast(t){const e=$('#toast');e.textContent=t;e.classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove('show'),2600)}
function hearts(ev){for(let i=0;i<5;i++){const h=document.createElement('span');h.className='heart';h.textContent=['💖','✨','💿','🎵','⭐'][i];h.style.left=(ev.clientX+(i-2)*22)+'px';h.style.top=ev.clientY+'px';document.body.appendChild(h);setTimeout(()=>h.remove(),1000)}}
function fly(b){const r=b.getBoundingClientRect(),c=$('#cartBtn').getBoundingClientRect(),e=document.createElement('span');e.className='fly';e.textContent='💿';e.style.left=r.left+r.width/2+'px';e.style.top=r.top+'px';document.body.appendChild(e);requestAnimationFrame(()=>{e.style.transform=`translate(${c.left-r.left}px,${c.top-r.top}px) scale(.4) rotate(540deg)`});setTimeout(()=>{e.remove();const k=$('#cartBtn');k.classList.remove('bump');void k.offsetWidth;k.classList.add('bump')},700)}
const imgs=a=>Array.isArray(a.imgs)?a.imgs:[];

function route(){let h=(location.hash||'#inicio').slice(1);if(!R[h])h='inicio';if(h==='boys'||h==='girls')cat=h;
 document.querySelectorAll('.pg').forEach(p=>p.hidden=p.id!==R[h]);document.querySelectorAll('nav [data-r]').forEach(a=>a.classList.toggle('hot',a.dataset.r===h));
 $('#shopT').textContent=cat==='boys'?'💙 Boy Groups':'💖 Girl Groups';filter='Todos';$('#q').value='';scrollTo(0,0);render()}
function card(a){const g=grads[a.id%5],im=imgs(a)[0];return `<article class="card" data-open="${a.id}" style="cursor:pointer">${admin?`<button class="del" data-edit="${a.id}" style="right:62px">✏️</button><button class="del" data-del="${a.id}">🗑</button>`:''}<span class="tag">${a.stock<=0?'Agotado':a.stock<=3?'¡Últimos!':'NEW'}</span><div class="cover" style="background:linear-gradient(135deg,${g[0]},${g[1]})"><div class="disc"></div>${im?`<img src="${esc(im)}" alt="${esc(a.title)}" style="position:relative;z-index:1">`:`<div class="art">${esc(a.grp)}<br>✦<br>${esc(a.title)}</div>`}</div><h3>${esc(a.title)}</h3><small>${esc(a.grp)} · ${esc(a.ver||'')}</small><div class="row"><span class="price">${money(a.price)}</span><button class="pill hot" data-add="${a.id}" ${a.stock<=0?'disabled':''}>💖 Agregar</button></div></article>`}
function render(){const L=albums.filter(a=>a.cat===cat),q=$('#q').value.trim().toLowerCase();
 $('#chips').innerHTML=['Todos',...new Set(L.map(a=>a.grp))].map(g=>`<button class="chip ${g===filter?'on':''}" data-g="${esc(g)}">${esc(g)}</button>`).join('');
 const l=L.filter(a=>(filter==='Todos'||a.grp===filter)&&(!q||(a.grp+' '+a.title+' '+(a.ver||'')).toLowerCase().includes(q)));
 $('#grid').innerHTML=l.length?l.map(card).join(''):`<div class="empty" style="grid-column:1/-1">${L.length?'No encontramos ese álbum 🥺':'Aún no hay álbumes en esta sección 💿'}</div>`;$('#newGrid').innerHTML=albums.length?albums.slice(0,8).map(card).join(''):'<div class="empty" style="grid-column:1/-1">Pronto subiremos álbumes nuevos 💿</div>'}
function openAlbum(id){const a=albums.find(x=>x.id===id);if(!a)return;const im=imgs(a);
 $('#dBox').innerHTML=`<h2>${esc(a.title)}</h2><small>${esc(a.grp)} · ${esc(a.ver||'')}</small>${im.length?`<div class="gal"><img id="gMain" src="${esc(im[0])}" alt="">${im.map(u=>`<img src="${esc(u)}" data-th="1" alt="">`).join('')}</div>`:''}<p class="price">${money(a.price)} · ${a.stock>0?'Stock: '+a.stock:'Agotado'}</p>${a.descr?`<p class="pre">${esc(a.descr)}</p>`:''}${a.contents?`<b>Contenido:</b><p class="pre">${esc(a.contents)}</p>`:''}${a.vid?`<video src="${esc(a.vid)}" controls playsinline style="width:100%;border-radius:16px"></video>`:''}<p><button class="pill hot" data-add="${a.id}" ${a.stock<=0?'disabled':''}>💖 Agregar al carrito</button> <button class="pill" data-close>Cerrar</button></p>`;$('#dM').classList.add('open')}
function drawVideo(){$('#player').innerHTML=vid?`<video src="${esc(vid)}" controls playsinline></video>`:'<div class="play">▶</div>'}
function drawAbout(){const a={...AD,...about};
 $('#abBox').innerHTML=`<div class="fun" style="font-size:1.8rem;text-align:center;color:var(--pink2)">${esc(a.slogan)}</div>`+[['story','📖 Nuestra historia'],['purpose','🎯 Nuestro propósito'],['mission','🚀 Misión'],['vision','🔭 Visión'],['values','💎 Valores']].map(([k,t])=>`<h3>${t}</h3><p class="pre">${esc(a[k])}</p>`).join('');
 $('#teamG').innerHTML=[1,2,3,4,5].map(i=>{const m=team.find(x=>x.id===i)||{};return `<div class="card" style="text-align:center"><img class="ph" src="${esc(m.photo||MASC[(i-1)%4])}" alt=""><h3>${esc(m.name||'Integrante '+i)}</h3><small>${esc(m.role||'Cargo en el equipo')}</small><p style="font-weight:700">${esc(m.bio||'')}</p></div>`}).join('')}
function fillAdmin(){const a={...AD,...about};$('#nSlogan').value=a.slogan;$('#nStory').value=a.story;$('#nPurpose').value=a.purpose;$('#nMission').value=a.mission;$('#nVision').value=a.vision;$('#nValues').value=a.values;
 $('#tmForm').innerHTML=[1,2,3,4,5].map(i=>{const m=team.find(x=>x.id===i)||{};return `<div class="tm"><b>Integrante ${i}</b><input id="tn${i}" placeholder="Nombre" value="${esc(m.name||'')}"><input id="tr${i}" placeholder="Cargo o función" value="${esc(m.role||'')}"><textarea id="tb${i}" placeholder="Presentación personal">${esc(m.bio||'')}</textarea><input id="tf${i}" type="file" accept="image/*"></div>`}).join('')}
async function load(){
  if(!sbOn()){render();drawVideo();drawAbout();renderCart();return;}
  try{
    const [al,tm,st]=await Promise.all([
      sbGet('albums','select=*&order=created_at.desc').catch(()=>[]),
      sbGet('team','select=*&order=id').catch(()=>[]),
      sbGet('site_settings','select=*').catch(()=>[])
    ]);
    albums=Array.isArray(al)?al:[];
    team=Array.isArray(tm)?tm:[];
    about={};vid='';
    if(Array.isArray(st)){
      st.forEach(s=>{if(s.key==='about')about=s.value||{};if(s.key==='video')vid=s.value||''});
    }
  }catch(x){}
  render();drawVideo();drawAbout();renderCart();
  if(admin&&$('#adm').hidden)fillAdmin();
}

function renderCart(){const L=cart.map(c=>({c,a:albums.find(x=>x.id===c.id)})).filter(o=>o.a),tot=L.reduce((s,o)=>s+o.a.price*o.c.qty,0);
 $('#cnt').textContent=cart.reduce((s,c)=>s+c.qty,0);$('#total').textContent=money(tot);$('#payTot').textContent=money(tot);
 $('#items').innerHTML=L.length?L.map(({c,a})=>`<div class="item"><span>${esc(a.grp)} – ${esc(a.title)}<br>${money(a.price)}</span><button data-m="${a.id}">−</button>${c.qty}<button data-p="${a.id}">+</button><button data-x="${a.id}" title="Quitar">✕</button></div>`).join(''):'<div class="empty">Tu carrito está vacío 💿<br>¡Agrega un álbum!</div>';
 const Lm=50000,left=Lm-tot;$('#ship').innerHTML=!L.length?'🚚 Envío gratis desde '+money(Lm):left>0?`🚚 Te faltan ${money(left)} para envío gratis<div class="bar"><i style="width:${tot/Lm*100}%"></i></div>`:'🎉 ¡Envío gratis desbloqueado!<div class="bar"><i style="width:100%"></i></div>';
 lset('pk_cart',cart);return tot}
function mailHtml(r,b){const rows=r.items.map(i=>`<tr><td style="padding:10px;border-bottom:1px solid #ffd6e8"><b>${esc(i.titulo)}</b><br><span style="color:#8a5a7a">${esc(i.grupo)} · ${esc(i.ver||'')}</span></td><td align="center" style="border-bottom:1px solid #ffd6e8">${i.qty}</td><td align="right" style="border-bottom:1px solid #ffd6e8">${money(i.precio)}</td><td align="right" style="border-bottom:1px solid #ffd6e8"><b>${money(i.precio*i.qty)}</b></td></tr>`).join('');
 return `<div style="background:#fff7fb;padding:24px;font-family:Arial,sans-serif;color:#5b2147"><div style="max-width:620px;margin:auto;background:#fff;border:4px solid #5b2147;border-radius:24px;overflow:hidden"><div style="background:linear-gradient(90deg,#ffc4dc,#b5e6f2);padding:22px;text-align:center"><div style="font-size:34px;font-weight:900;color:#fff;text-shadow:2px 2px 0 #5b2147">💿 Pookie Store</div><div style="font-weight:bold">¡Nuevo pedido recibido! 💖</div></div><div style="padding:22px"><p style="font-size:18px">Pedido <b style="background:#ff8fbd;color:#fff;padding:3px 12px;border-radius:99px">${esc(r.num)}</b></p><h3>👤 Comprador</h3><p>${esc(b.nombre)}<br>${esc(b.email)}<br>${esc(b.tel||'—')}</p><h3>📦 Despacho</h3><p>${esc(b.dir)}</p><h3>🛒 Productos</h3><table width="100%" style="border-collapse:collapse;font-size:14px"><tr style="background:#fdeaf3"><th align="left" style="padding:8px">Producto</th><th>Cant.</th><th align="right">Precio</th><th align="right">Subtotal</th></tr>${rows}</table><p style="text-align:right;font-size:22px">Total: <b style="color:#ff5fa5">${money(r.total)}</b></p><p>💳 Pago: Transferencia (pendiente de confirmar)</p></div></div></div>`}
async function sendMail(r,b){chk(await fetch('https://api.emailjs.com/api/v1.0/email/send',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({service_id:CFG.ejs,template_id:CFG.ejt,user_id:CFG.ejk,template_params:{to_email:NOTIFY,subject:'🛍️ Nuevo pedido '+r.num+' – Pookie Store',html:mailHtml(r,b),reply_to:b.email}})}))}
async function loadOrders(){try{const o=await sbGet('orders','select=*&order=created_at.desc&limit=30');$('#oList').innerHTML=o.length?o.map(r=>`<div class="item"><span><b>${esc(r.num)}</b> · ${esc(r.nombre)}<br>${esc(r.email)} · ${money(r.total)}<br><small>${new Date(r.created_at).toLocaleString('es-CL')}</small></span></div>`).join(''):'Aún no hay pedidos';}catch(x){$('#oList').textContent='No se pudieron cargar los pedidos'}}
function showTab(n){['prod','vid','nos','ped'].forEach(k=>$('#t-'+k).hidden=k!==n);document.querySelectorAll('[data-tab]').forEach(b=>b.classList.toggle('on',b.dataset.tab===n));if(n==='ped')loadOrders()}
function clearForm(){['pGrp','pTit','pVer','pPrice','pStock','pDesc','pCont','pImgs','pVid'].forEach(i=>$('#'+i).value='');editId=null;$('#pSave').textContent='Publicar';$('#pCancel').hidden=true}
function openAdmin(){if(!admin)return $('#loginM').classList.add('open');$('#adm').hidden=!$('#adm').hidden;if(!$('#adm').hidden)fillAdmin()}

document.addEventListener('click',e=>{
 if(e.target.dataset.th){$('#gMain').src=e.target.src;return}
 const t=e.target.closest('button,[data-close]');
 if(!t){const c=e.target.closest('[data-open]');if(c)openAlbum(+c.dataset.open);return}
 if(t.dataset.g){filter=t.dataset.g;render()}
 if(t.dataset.tab)showTab(t.dataset.tab);
 if(t.dataset.add){const id=+t.dataset.add,a=albums.find(x=>x.id===id),c=cart.find(x=>x.id===id);if(!a||(c?c.qty:0)>=a.stock)return toast('No hay más stock 🥺');c?c.qty++:cart.push({id,qty:1});renderCart();fly(t);hearts(e);toast('¡Agregado al carrito! 💖')}
 if(t.dataset.p){const c=cart.find(x=>x.id==t.dataset.p),a=albums.find(x=>x.id==t.dataset.p);if(c.qty<a.stock)c.qty++;else toast('Sin más stock');renderCart()}
 if(t.dataset.m){const c=cart.find(x=>x.id==t.dataset.m);c.qty--;cart=cart.filter(x=>x.qty>0);renderCart()}
 if(t.dataset.x){const el=t.closest('.item');el.classList.add('out');setTimeout(()=>{cart=cart.filter(x=>x.id!=t.dataset.x);renderCart()},250)}
 if(t.dataset.edit){const a=albums.find(x=>x.id==t.dataset.edit);editId=a.id;$('#pCat').value=a.cat;$('#pGrp').value=a.grp;$('#pTit').value=a.title;$('#pVer').value=a.ver||'';$('#pPrice').value=a.price;$('#pStock').value=a.stock;$('#pDesc').value=a.descr||'';$('#pCont').value=a.contents||'';$('#pSave').textContent='Guardar cambios';$('#pCancel').hidden=false;$('#adm').hidden=false;showTab('prod');$('#adm').scrollTop=0}
 if(t.dataset.del){if(t.dataset.arm!=='1'){t.dataset.arm='1';const o=t.textContent;t.textContent='¿Seguro?';setTimeout(()=>{t.dataset.arm='';t.textContent=o},2500);return}
  sbDel('albums','id=eq.'+t.dataset.del).then(()=>{cart=cart.filter(c=>c.id!=t.dataset.del);load();toast('Álbum borrado 🗑')}).catch(()=>toast('No se pudo borrar 🥺'))}
 if(t.hasAttribute('data-close')){t.closest('.modal').classList.remove('open');$('#dBox').innerHTML=''}
});
addEventListener('hashchange',route);$('#q').addEventListener('input',render);
$('#cartBtn').onclick=()=>$('#drawer').classList.add('open');$('#closeCart').onclick=()=>$('#drawer').classList.remove('open');
$('#checkout').onclick=()=>{if(!cart.length)return toast('Agrega algo primero 💿');$('#drawer').classList.remove('open');$('#payM').classList.add('open')};
$('#lg').onclick=openAdmin;$('#secret').onclick=openAdmin;$('#aClose').onclick=()=>$('#adm').hidden=true;$('#aOut').onclick=out;
$('#cfgBtn').onclick=()=>$('#cfgBar').hidden=!$('#cfgBar').hidden;
$('#cfSave').onclick=()=>{const o={url:$('#cfU').value.trim().replace(/\/+$/,''),ejs:$('#cfS').value.trim(),ejt:$('#cfT').value.trim(),ejk:$('#cfK').value.trim()};Object.keys(o).forEach(k=>{if(!o[k])delete o[k]});lset('pk_cfg',o);location.reload()};
$('#lgo').onclick=async()=>{if(await sbLogin($('#lu').value,$('#lp').value)){admin=true;$('#loginM').classList.remove('open');$('#adm').hidden=false;fillAdmin();render();toast('¡Bienvenida, admin! 💖')}else toast('Usuario o clave incorrectos')};
$('#pCancel').onclick=clearForm;
$('#pSave').onclick=async()=>{const g=$('#pGrp').value.trim(),t=$('#pTit').value.trim(),p=+$('#pPrice').value;if(!g||!t||!p)return toast('Completa grupo, álbum y precio');
 const old=albums.find(a=>a.id===editId),nf=[...$('#pImgs').files],v=$('#pVid').files[0];$('#pSave').disabled=true;toast('Guardando… ⏳');
 try{const ni=await Promise.all(nf.map(f=>sbUp(f,'albums')));
  const row={cat:$('#pCat').value,grp:g,title:t,ver:$('#pVer').value.trim(),price:p,stock:+$('#pStock').value||0,descr:$('#pDesc').value,contents:$('#pCont').value,imgs:nf.length?ni:(old?imgs(old):[]),vid:v?await sbUp(v,'albums-video'):(old?old.vid||'':'')};
  if(editId)await sbPatch('albums','id=eq.'+editId,row);else await sbPost('albums',row);
  clearForm();await load();toast('¡Guardado! 🎉')}catch(x){toast('No se pudo guardar 🥺 (revisa tablas/permisos en Supabase)')}$('#pSave').disabled=false};
$('#vSave').onclick=async()=>{const f=$('#vFile').files[0];if(!f)return toast('Elige un video');try{toast('Subiendo video… ⏳');const u=await sbUp(f,'tutorial');await sbPost('site_settings',{key:'video',value:u});vid=u;drawVideo();toast('Video publicado 🎬')}catch(x){toast('No se pudo subir el video 🥺 (máx. 50 MB en plan gratis)')}};
$('#vDel').onclick=async()=>{try{await sbDel('site_settings','key=eq.video');vid='';drawVideo();toast('Video eliminado')}catch(x){toast('No se pudo eliminar 🥺')}};
$('#nSave').onclick=async()=>{try{await sbPost('site_settings',{key:'about',value:{slogan:$('#nSlogan').value,story:$('#nStory').value,purpose:$('#nPurpose').value,mission:$('#nMission').value,vision:$('#nVision').value,values:$('#nValues').value}});await load();toast('Nosotros guardado 💖')}catch(x){toast('No se pudo guardar 🥺')}};
$('#tSave').onclick=async()=>{try{toast('Guardando equipo… ⏳');const rows=await Promise.all([1,2,3,4,5].map(async i=>{const m=team.find(x=>x.id===i)||{},f=$('#tf'+i).files[0];return{id:i,name:$('#tn'+i).value,role:$('#tr'+i).value,bio:$('#tb'+i).value,photo:f?await sbUp(f,'team'):(m.photo||'')}}));await sbPost('team',rows);await load();toast('Equipo guardado 💖')}catch(x){toast('No se pudo guardar 🥺')}};
$('#payF').onsubmit=async e=>{e.preventDefault();if(!sbOn())return toast('Falta conectar Supabase (⚙)');const b={nombre:$('#cName').value.trim(),email:$('#cMail').value.trim(),tel:$('#cTel').value.trim(),dir:$('#cAddr').value.trim()},btn=$('#payGo');btn.disabled=true;btn.textContent='Procesando…';
 try{const r=await sbRpc('crear_pedido',{p_nombre:b.nombre,p_email:b.email,p_tel:b.tel,p_dir:b.dir,p_items:cart.map(c=>({id:c.id,qty:c.qty}))});
  let sent=false;try{await sendMail(r,b);sent=true}catch(x){}
  cart=[];renderCart();load();$('#payM').classList.remove('open');$('#doneTxt').textContent='Tu pedido '+r.num+' quedó registrado. '+(sent?'Ya avisamos a la tienda por correo 📧':'El pedido quedó guardado, pero el aviso por correo no pudo enviarse.');$('#doneM').classList.add('open')}
 catch(x){toast('No se pudo completar la compra 🥺 revisa el stock')}btn.disabled=false;btn.textContent='Confirmar compra'};
document.querySelectorAll('.mascot').forEach(m=>m.onclick=ev=>{m.classList.add('hop');hearts(ev);setTimeout(()=>m.classList.remove('hop'),600)});
$('#cfU').value=CFG.url;$('#cfS').value=CFG.ejs;$('#cfT').value=CFG.ejt;$('#cfK').value=CFG.ejk;$('#cfgBar').hidden=true;
route();renderCart();drawVideo();drawAbout();load();
</script>
</body>
